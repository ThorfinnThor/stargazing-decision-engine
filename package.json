{
  "name": "stargazing-decision-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && python3 -m unittest discover -s tests -p '*_python_test.py'",
    "data:schemas:validate": "node --import tsx scripts/validate/validate-schemas.ts",
    "data:seed:validate": "node --import tsx scripts/validate/validate-seed-config.ts",
    "data:seed": "node --import tsx scripts/import/build-seed.ts",
    "data:era5:fetch": "python3 scripts/import/fetch-era5.py",
    "data:era5:process": "node --import tsx scripts/import/process-era5.ts",
    "data:era5:validate": "node --import tsx scripts/validate/validate-climate-snapshots.ts",
    "data:black-marble:fetch": "python3 scripts/import/fetch_black_marble.py",
    "data:black-marble:extract": "python3 scripts/import/extract_black_marble.py",
    "data:black-marble:process": "node --import tsx scripts/import/process-black-marble.ts",
    "data:black-marble:validate": "node --import tsx scripts/validate/validate-black-marble-snapshots.ts",
    "data:darkness:calibrate": "node --import tsx scripts/calibrate/darkness.ts",
    "data:darkness:validate": "node --import tsx scripts/validate/validate-darkness-calibration.ts",
    "data:dem:fetch": "python3 scripts/import/fetch_dem.py",
    "data:dem:process": "python3 scripts/import/process_dem.py",
    "data:dem:validate": "node --import tsx scripts/validate/validate-dem-snapshots.ts",
    "data:normalize": "node --import tsx scripts/normalize/normalize.ts",
    "data:score": "node --import tsx scripts/score/score.ts",
    "data:score:real": "node --import tsx scripts/score/score-real.ts",
    "data:score:config:validate": "node --import tsx scripts/validate/validate-score-config.ts",
    "data:score:real:validate": "node --import tsx scripts/validate/validate-site-score-snapshots.ts",
    "data:meteor-showers": "node --import tsx scripts/events/build-meteor-showers.ts",
    "data:meteor-showers:validate": "node --import tsx scripts/validate/validate-meteor-showers.ts",
    "data:shorttrips": "node --import tsx scripts/trips/build-short-trips.ts",
    "data:shorttrips:validate": "node --import tsx scripts/validate/validate-short-trips.ts",
    "data:seo": "node --import tsx scripts/seo/build-seo.ts",
    "data:seo:validate": "node --import tsx scripts/validate/validate-seo.ts",
    "data:affiliate:validate": "node --import tsx scripts/validate/validate-affiliate.ts",
    "data:affiliate": "node --import tsx scripts/affiliate/build-redirects.ts",
    "data:gear": "node --import tsx scripts/gear/build-gear.ts",
    "data:gear:validate": "node --import tsx scripts/validate/validate-gear.ts",
    "data:images": "node --import tsx scripts/images/build-image-manifest.ts",
    "data:images:validate": "node --import tsx scripts/validate/validate-images.ts",
    "data:calendar:seed": "node --import tsx scripts/calendar/build-calendar.ts",
    "data:calendar:real": "node --import tsx scripts/calendar/build-calendar-real.ts",
    "data:calendar:manifest": "node --import tsx scripts/calendar/refresh-calendar-manifest.ts",
    "data:calendar:validate": "node --import tsx scripts/validate/validate-calendar-files.ts",
    "data:milky-way:validate": "node --import tsx scripts/validate/validate-milky-way-config.ts",
    "data:health:validate": "node --import tsx scripts/validate/validate-health.ts",
    "data:export": "node --import tsx scripts/export/export.ts",
    "data:validate": "node --import tsx scripts/validate/validate-public-data.ts && node --import tsx scripts/validate/validate-climate-snapshots.ts && node --import tsx scripts/validate/validate-black-marble-snapshots.ts && node --import tsx scripts/validate/validate-dem-snapshots.ts && node --import tsx scripts/validate/validate-darkness-calibration.ts && node --import tsx scripts/validate/validate-score-config.ts && node --import tsx scripts/validate/validate-site-score-snapshots.ts && pnpm data:milky-way:validate && pnpm data:meteor-showers:validate && node --import tsx scripts/validate/validate-calendar-files.ts",
    "data:pipeline": "pnpm data:seed && pnpm data:normalize && pnpm data:score && pnpm data:meteor-showers && pnpm data:shorttrips && pnpm data:export && pnpm data:gear && pnpm data:images && pnpm data:seo && pnpm data:affiliate && pnpm data:validate && pnpm data:affiliate:validate && pnpm data:gear:validate && pnpm data:images:validate",
    "data:rebuild": "pnpm data:seed && pnpm data:normalize && pnpm data:score && pnpm data:meteor-showers && pnpm data:shorttrips && pnpm data:export && pnpm data:gear && pnpm data:images && pnpm data:seo && pnpm data:affiliate && pnpm data:validate && pnpm data:affiliate:validate && pnpm data:gear:validate && pnpm data:images:validate"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "csv-parse": "7.0.2",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "ajv": "8.17.1",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  }
}
