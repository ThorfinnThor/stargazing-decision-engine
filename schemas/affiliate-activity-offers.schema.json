{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargazing.local/schema/affiliate-activity-offers.json",
  "title": "Curated affiliate activity offers",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "offers"],
  "properties": {
    "version": { "const": 1 },
    "offers": { "type": "array", "items": { "$ref": "#/$defs/offer" } }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "partnerId", "destinationId", "locationTourSlugs", "enabled", "title", "description", "urlTemplate", "lastReviewedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "partnerId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "destinationId": { "type": "string", "minLength": 1 },
        "locationTourSlugs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "enabled": { "type": "boolean" },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "urlTemplate": { "type": "string", "pattern": "^https://" },
        "lastReviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
