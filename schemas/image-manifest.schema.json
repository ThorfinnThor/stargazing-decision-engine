{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargazing.local/schema/image-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "policy", "destinations", "sites"],
  "properties": {
    "version": { "const": 1 }, "generatedAt": { "type": "string", "minLength": 1 },
    "policy": { "type": "object", "additionalProperties": false, "required": ["allowedLicenses", "requiredFormat", "hosting"], "properties": { "allowedLicenses": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "requiredFormat": { "const": "webp" }, "hosting": { "const": "self" } } },
    "destinations": { "type": "array", "items": { "$ref": "#/$defs/asset" } }, "sites": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": { "asset": { "type": "object", "additionalProperties": false, "required": ["slug", "status", "localPath", "sourceUrl", "sourceTitle", "author", "license", "licenseUrl", "attribution", "alt", "checkedAt", "overrideReason"], "properties": {
    "slug": { "type": "string", "minLength": 1 }, "status": { "enum": ["pending", "approved"] }, "localPath": { "type": ["string", "null"] }, "sourceUrl": { "type": ["string", "null"] }, "sourceTitle": { "type": ["string", "null"] }, "author": { "type": ["string", "null"] }, "license": { "type": ["string", "null"] }, "licenseUrl": { "type": ["string", "null"] }, "attribution": { "type": ["string", "null"] }, "alt": { "$ref": "#/$defs/bilingual" }, "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "overrideReason": { "type": ["string", "null"] }
  } }, "bilingual": { "type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } } } }
}
