{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargazing.local/schema/gear-guide.json",
  "title": "Gear Guide",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "category", "summary", "decisionSummary", "audience", "buyingCriteria", "items", "tradeoffs", "faq", "affiliateDisclosure", "lastReviewedAt"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "$ref": "#/$defs/bilingual" }, "category": { "type": "string", "minLength": 1 }, "summary": { "$ref": "#/$defs/bilingual" }, "decisionSummary": { "$ref": "#/$defs/bilingual" }, "audience": { "$ref": "#/$defs/bilingual" },
    "buyingCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bilingual" } },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "tradeoffs": { "$ref": "#/$defs/lists" },
    "faq": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["question", "answer"], "properties": { "question": { "$ref": "#/$defs/bilingual" }, "answer": { "$ref": "#/$defs/bilingual" } } } },
    "affiliateDisclosure": { "$ref": "#/$defs/bilingual" }, "lastReviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "$defs": {
    "bilingual": { "type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } } },
    "lists": { "type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": { "en": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "de": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "item": { "type": "object", "additionalProperties": false, "required": ["name", "whyItMatters", "coreSpecs", "pros", "cons", "recommendationBasis", "partnerSearchQuery", "affiliatePartnerId"], "properties": { "name": { "$ref": "#/$defs/bilingual" }, "whyItMatters": { "$ref": "#/$defs/bilingual" }, "coreSpecs": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }, "localizedCoreSpecs": { "$ref": "#/$defs/localizedSpecs" }, "pros": { "$ref": "#/$defs/lists" }, "cons": { "$ref": "#/$defs/lists" }, "recommendationBasis": { "const": "specification_analysis" }, "partnerSearchQuery": { "type": "string", "minLength": 1 }, "affiliatePartnerId": { "type": ["string", "null"] }, "source": { "type": "object", "additionalProperties": false, "required": ["publisher", "title", "url", "checkedAt"], "properties": { "publisher": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https://" }, "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } } } } },
    "localizedSpecs": { "type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": { "en": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }, "de": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } } } }
  }
}
