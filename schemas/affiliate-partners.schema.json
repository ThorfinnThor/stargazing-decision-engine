{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargazing.local/schema/affiliate-partners.json",
  "title": "Affiliate Partner Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "partners"],
  "properties": {
    "version": { "const": 1 },
    "partners": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/partner" } }
  },
  "$defs": {
    "partner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "enabled", "affiliateId", "destinationSearchEnabled", "urlTemplate", "allowedHosts", "requiredQueryParameters", "disclosure"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["hotel", "activity", "camping", "car_rental", "gear"] },
        "enabled": { "type": "boolean" },
        "affiliateId": { "type": "string" },
        "destinationSearchEnabled": { "type": "boolean" },
        "destinationSearchVariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "queryTemplate"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "queryTemplate": { "type": "string", "minLength": 1 }
            }
          }
        },
        "widget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "enabled", "campaign", "scriptUrl", "frameUrl", "itemCount", "destinationIds"],
          "properties": {
            "type": { "const": "activities" },
            "enabled": { "type": "boolean" },
            "campaign": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
            "scriptUrl": { "type": "string", "pattern": "^https://" },
            "frameUrl": { "type": "string", "pattern": "^https://" },
            "itemCount": { "type": "integer", "minimum": 1, "maximum": 5 },
            "destinationIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
            }
          }
        },
        "urlTemplate": { "type": ["string", "null"], "pattern": "^https://" },
        "allowedHosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requiredQueryParameters": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }, "uniqueItems": true },
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "de"],
          "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
