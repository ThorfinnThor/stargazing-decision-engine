{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargazing.local/schema/black-marble-snapshot.json",
  "title": "Black Marble Site Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteId", "source", "collectionVersion", "radianceLayer", "qualityLayer", "units", "blackMarbleYears", "baselineOverrideUsed", "coverageOverrideUsed", "rings", "radiance0to2", "radiance2to10", "radiance10to30", "radiance30to75", "alanExposure", "darknessScore", "coverage", "warnings", "retrievedAt"],
  "properties": {
    "siteId": { "type": "string", "minLength": 1 },
    "source": { "const": "VNP46A4" },
    "collectionVersion": { "const": "2" },
    "radianceLayer": { "const": "AllAngle_Composite_Snow_Free" },
    "qualityLayer": { "const": "AllAngle_Composite_Snow_Free_Quality" },
    "units": { "const": "nW/cm2/sr" },
    "blackMarbleYears": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "integer", "minimum": 2012 } },
    "baselineOverrideUsed": { "type": "boolean" },
    "coverageOverrideUsed": { "type": "boolean" },
    "rings": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/ring" } },
    "radiance0to2": { "$ref": "#/$defs/nullableRadiance" },
    "radiance2to10": { "$ref": "#/$defs/nullableRadiance" },
    "radiance10to30": { "$ref": "#/$defs/nullableRadiance" },
    "radiance30to75": { "$ref": "#/$defs/nullableRadiance" },
    "alanExposure": { "$ref": "#/$defs/nullableRadiance" },
    "darknessScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "coverage": { "$ref": "#/$defs/probability" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "retrievedAt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "nullableRadiance": { "type": ["number", "null"], "minimum": 0 },
    "year": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "radiance", "coverage", "validPixelCount", "totalPixelCount"],
      "properties": {
        "year": { "type": "integer", "minimum": 2012 },
        "radiance": { "$ref": "#/$defs/nullableRadiance" },
        "coverage": { "$ref": "#/$defs/probability" },
        "validPixelCount": { "type": "integer", "minimum": 0 },
        "totalPixelCount": { "type": "integer", "minimum": 0 }
      }
    },
    "ring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minKm", "maxKm", "upperInclusive", "statistic", "alanWeight", "radiance", "coverage", "years"],
      "properties": {
        "id": { "enum": ["0to2", "2to10", "10to30", "30to75"] },
        "minKm": { "type": "number", "minimum": 0 },
        "maxKm": { "type": "number", "exclusiveMinimum": 0, "maximum": 75 },
        "upperInclusive": { "type": "boolean" },
        "statistic": { "enum": ["median", "mean"] },
        "alanWeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "radiance": { "$ref": "#/$defs/nullableRadiance" },
        "coverage": { "$ref": "#/$defs/probability" },
        "years": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/year" } }
      }
    }
  }
}
