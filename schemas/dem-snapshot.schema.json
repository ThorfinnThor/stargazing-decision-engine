{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargazing.local/schema/dem-snapshot.json",
  "title": "Copernicus DEM Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteId", "source", "dataset", "modelType", "resolutionM", "resolutionArcSeconds", "verticalDatum", "requestedPoint", "tile", "sourceObject", "publicFallback", "elevationM", "neighborhoods", "noDataPolicy", "coverage", "warnings", "retrievedAt"],
  "properties": {
    "siteId": { "type": "string", "minLength": 1 },
    "source": { "const": "copernicus-dem-glo-30" },
    "dataset": { "const": "COP-DEM_GLO-30-DGED" },
    "modelType": { "const": "DSM" },
    "resolutionM": { "const": 30 },
    "resolutionArcSeconds": { "const": 1 },
    "verticalDatum": { "const": "EGM2008" },
    "requestedPoint": { "$ref": "#/$defs/coordinate" },
    "tile": { "type": "string", "pattern": "^[NS][0-9]{2}_00_[EW][0-9]{3}_00$" },
    "sourceObject": { "type": "string", "pattern": "^s3://[^/]+/.+" },
    "publicFallback": { "type": "boolean" },
    "elevationM": { "$ref": "#/$defs/nullableElevation" },
    "neighborhoods": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["radiusKm", "elevationM", "validSampleCount"],
        "properties": {
          "radiusKm": { "type": "number", "exclusiveMinimum": 0 },
          "elevationM": { "$ref": "#/$defs/nullableElevation" },
          "validSampleCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "noDataPolicy": { "const": "masked-or-nodata-values-excluded" },
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "retrievedAt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 }
      ]
    },
    "nullableElevation": { "type": ["number", "null"], "minimum": -500, "maximum": 9000 }
  }
}
