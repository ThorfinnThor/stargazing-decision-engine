{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargazing.local/schema/gear-category.json",
  "type": "array",
  "items": { "type": "object", "additionalProperties": false, "required": ["id", "slug", "name", "description"], "properties": {
    "id": { "type": "string", "minLength": 1 }, "slug": { "type": "string", "minLength": 1 },
    "name": { "$ref": "#/$defs/bilingual" }, "description": { "$ref": "#/$defs/bilingual" }
  } },
  "$defs": { "bilingual": { "type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } } } }
}
