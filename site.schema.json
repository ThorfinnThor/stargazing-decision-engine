{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargazing.local/schema/site.json",
  "title": "Observation Site",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "destinationId", "name", "lat", "lon", "elevationM", "siteType", "publicAccess", "accessScore", "active", "priority", "certificationIds"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "destinationId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "elevationM": { "type": ["number", "null"], "minimum": 0 },
    "siteType": { "type": "string", "minLength": 1 },
    "publicAccess": { "enum": ["yes", "limited", "unknown", "no"] },
    "accessScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "active": { "type": "boolean" },
    "priority": { "type": "integer", "minimum": 0 },
    "certificationIds": { "type": "array", "items": { "type": "string" } },
    "notesSourceUrl": { "type": ["string", "null"], "minLength": 1 }
  }
}
